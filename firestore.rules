rules_version = '2';
// Reglas de Firestore del proyecto akc-con-reporte (compartido entre las apps de AKC y ProGymnastics).
// SE COPIA COMPLETO a Consola de Firebase → Firestore → Reglas → Publicar (reemplaza todo lo que haya ahí).
// - AKC: todas sus colecciones siguen abiertas como siempre (primer bloque).
// - ProGymnastics: colecciones pg_*, cerradas por perfil.
// Perfiles: SUPER (Desarrollador), OWNER, ADMIN (administración), COACH, TUTOR, ATLETA (ver js/sesion.js).
// SUPER solo se da creando a mano su invitación en la consola; desde la app nadie lo da, cambia ni quita.
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== AKC: igual que antes (todo abierto), excepto las colecciones pg_ =====
    match /{coleccion}/{document=**} {
      allow read, write: if !coleccion.matches('pg_.*');
    }

    // ===== ProGymnastics (colecciones pg_) =====
    function pgDentro() { return request.auth != null; }
    function pgYo() { return get(/databases/$(database)/documents/pg_usuarios/$(request.auth.uid)).data; }
    function pgMiembro() { return pgDentro() && exists(/databases/$(database)/documents/pg_usuarios/$(request.auth.uid)); }
    function pgAdmin() { return pgMiembro() && pgYo().rol in ['SUPER', 'OWNER', 'ADMIN']; }
    function pgStaff() { return pgMiembro() && pgYo().rol in ['SUPER', 'OWNER', 'ADMIN', 'COACH']; }
    function pgOwner() { return pgMiembro() && pgYo().rol in ['SUPER', 'OWNER']; }
    function pgMio(atletaId) { return pgMiembro() && atletaId in pgYo().atletas; }
    function pgCorreo() { return request.auth.token.email.lower(); }
    function pgInv() { return get(/databases/$(database)/documents/pg_invitaciones/$(pgCorreo())).data; }

    match /pg_usuarios/{uid} {
      allow get: if pgDentro() && (request.auth.uid == uid || pgAdmin());
      allow list: if pgAdmin();
      // Primer ingreso: la cuenta se crea igual a su invitación.
      allow create: if pgDentro() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/pg_invitaciones/$(pgCorreo()))
        && request.resource.data.rol == pgInv().rol
        && request.resource.data.atletas == pgInv().atletas
        && request.resource.data.email == pgCorreo();
      // Administración edita; solo OWNER toca cuentas OWNER o da ese perfil; nadie cambia su propio perfil.
      // Las cuentas SUPER no se pueden editar ni borrar desde la app, y nadie puede dar ese perfil.
      allow update: if pgAdmin() && request.auth.uid != uid
        && resource.data.rol != 'SUPER' && request.resource.data.rol != 'SUPER'
        && (pgOwner() || (resource.data.rol != 'OWNER' && request.resource.data.rol != 'OWNER'));
      allow update: if pgAdmin() && request.auth.uid == uid && request.resource.data.rol == resource.data.rol;
      allow delete: if pgAdmin() && request.auth.uid != uid && resource.data.rol != 'SUPER'
        && (pgOwner() || resource.data.rol != 'OWNER');
    }

    match /pg_invitaciones/{email} {
      allow get: if pgDentro() && (pgCorreo() == email || pgAdmin());
      allow list: if pgAdmin();
      allow create, update: if pgAdmin() && email == email.lower() && request.resource.data.rol != 'SUPER'
        && (!exists(/databases/$(database)/documents/pg_invitaciones/$(email)) || resource.data.rol != 'SUPER')
        && (pgOwner() || request.resource.data.rol != 'OWNER');
      allow delete: if (pgAdmin() && resource.data.rol != 'SUPER') || (pgDentro() && pgCorreo() == email);
    }

    match /pg_atletas/{id} {
      allow get: if pgStaff() || pgMio(id);
      allow list: if pgStaff();
      allow write: if pgAdmin();
    }

    // Asistencia: la ven todos los miembros (Reporte de asistencia de cada sección; Manu, 17-nov-2026). Solo el staff toma lista.
    match /pg_asistencia/{id} {
      allow read: if pgMiembro();
      allow write: if pgStaff();
    }

    match /pg_pagos/{id} {
      allow read: if pgAdmin() || (resource != null && pgMio(resource.data.atletaId));
      allow write: if pgAdmin();
    }

    match /pg_avisos/{id} {
      allow read: if pgMiembro();
      allow create: if pgStaff() && request.resource.data.autorUid == request.auth.uid;
      allow delete: if pgAdmin() || (pgStaff() && resource.data.autorUid == request.auth.uid);
    }

    // Normativos: un documento por atleta. Staff lee y marca; tutor y atleta leen solo el suyo.
    match /pg_normativos/{atletaId} {
      allow get: if pgStaff() || pgMio(atletaId);
      allow list: if pgStaff();
      allow write: if pgStaff();
    }

    // Rutinas (editor de GAV): un solo documento "estado" con libres y obligatorios. Solo el staff.
    match /pg_rutinas/{doc} {
      allow read, write: if pgStaff();
    }

    // Nota de partida de la rutina de cada atleta (la publica el Editor de rutinas) para su reporte.
    match /pg_rutinas_vista/{atletaId} {
      allow get: if pgStaff() || pgMio(atletaId);
      allow list, write: if pgStaff();
    }

    // Copas: todos los miembros las ven (con «el más eficiente»); solo el staff las crea o cambia.
    match /pg_competencias/{id} {
      allow read: if pgMiembro();
      allow write: if pgStaff();
    }

    // Resultados: un documento por atleta y copa. Staff todo; tutor y atleta solo los suyos.
    match /pg_resultados/{id} {
      allow read: if pgStaff() || (resource != null && pgMio(resource.data.atletaId));
      allow write: if pgStaff();
    }

    match /pg_eventos/{id} {
      allow read: if pgMiembro();
      allow write: if pgStaff();
    }
  }
}
